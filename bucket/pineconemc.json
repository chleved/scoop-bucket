    },
    "checkver": {
        "url": "https://api.github.com/repos/ElyPrismLauncher/Launcher/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "releases/download/(?:v)?(?<version>[^/]+)/(?<name>[A-Za-z0-9_\\-]+)-Windows-MSVC-Setup-[^/]+\\.exe"
    },
    "autoupdate": {
        "url": "https://github.com/ElyPrismLauncher/Launcher/releases/download/$version/$matchName-Windows-MSVC-Setup-$version.exe"
    },
    "notes": [
        "PineconeMC uses Ely.by instead of Mojang/Microsoft for authentication.",
        "A Java runtime is required to play Minecraft. See the 'suggest' entries above.",
        "After install, launch PineconeMC from your Start Menu or Desktop shortcut."
    ]
